{
  "_comment": "Mirrors vanilla bow's structure (using_item + use_duration range_dispatch) but points at our layered models so the limb/riser/string all show. The pull-frame texture set is fixed (oak/wood/flax) — full per-material variation needs a fletcherstrestle:modular_bow ItemModel type registered through RegisterItemModelsEvent. TODO(port-26.1) for that.",
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:using_item",
    "on_false": {
      "type": "minecraft:model",
      "model": "fletcherstrestle:item/modular_bow/idle"
    },
    "on_true": {
      "type": "minecraft:range_dispatch",
      "property": "minecraft:use_duration",
      "scale": 0.05,
      "fallback": {
        "type": "minecraft:model",
        "model": "fletcherstrestle:item/modular_bow/pulling_0"
      },
      "entries": [
        {
          "threshold": 0.65,
          "model": {
            "type": "minecraft:model",
            "model": "fletcherstrestle:item/modular_bow/pulling_1"
          }
        },
        {
          "threshold": 0.9,
          "model": {
            "type": "minecraft:model",
            "model": "fletcherstrestle:item/modular_bow/pulling_2"
          }
        }
      ]
    }
  }
}
