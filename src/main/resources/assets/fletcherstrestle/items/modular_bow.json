{
  "_comment": "26.1 ItemModel resolver. Outer select dispatches on the fletcherstrestle:limb_material component the recipe writes, then each per-limb branch swaps between idle and the 3-frame pull animation via minecraft:condition + minecraft:range_dispatch. Riser + string are still fixed to wood/flax in the model files themselves \u2014 a follow-up will dispatch on those too.",
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:component",
    "component": "fletcherstrestle:limb_material",
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:using_item",
      "on_false": {
        "type": "minecraft:model",
        "model": "fletcherstrestle:item/modular_bow/idle_oak"
      },
      "on_true": {
        "type": "minecraft:range_dispatch",
        "property": "minecraft:use_duration",
        "scale": 0.05,
        "fallback": {
          "type": "minecraft:model",
          "model": "fletcherstrestle:item/modular_bow/pulling_oak_0"
        },
        "entries": [
          {
            "threshold": 0.65,
            "model": {
              "type": "minecraft:model",
              "model": "fletcherstrestle:item/modular_bow/pulling_oak_1"
            }
          },
          {
            "threshold": 0.9,
            "model": {
              "type": "minecraft:model",
              "model": "fletcherstrestle:item/modular_bow/pulling_oak_2"
            }
          }
        ]
      }
    },
